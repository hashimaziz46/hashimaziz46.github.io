---
import Eyebrow from '@/components/shared/eyebrow/eyebrow.astro'
import ProfileCarousel from '@/components/home/about/profile-carousel'
import EducationCard from '@/components/home/about/education-card'
import PlaybookFolderCard from '@/components/home/about/playbook-folder-card'
import OffClockCard from '@/components/home/about/off-clock-card'
---

<section id='about' class='border-b py-8 sm:py-16 lg:py-24'>
  <div class='mx-auto max-w-7xl space-y-8 px-4 sm:px-6 lg:space-y-16 lg:px-10.5'>
    <div class='space-y-2'>
      <Eyebrow text='About me' />
      <h2 class='text-2xl font-semibold md:text-3xl lg:text-4xl'>The person behind the delivery</h2>
      <p class='text-muted-foreground max-w-2xl pt-2 text-base'>
        Software engineer turned Project Manager. I wrote React and Node code at GitStart for three years, and led the
        teams writing it for two of them - so I know what a realistic sprint looks like from both sides. Today I help
        clients turn messy requirements into roadmaps their engineers believe in.
      </p>
    </div>

    <!-- Photo on the left, Education and Playbook stacked beside it, hobbies full width below -->
    <div class='grid grid-cols-1 gap-4 md:grid-cols-[320px_1fr] lg:grid-cols-[380px_1fr]'>
      <ProfileCarousel client:visible />

      <div class='grid gap-4 md:h-140 md:grid-rows-2'>
        <EducationCard />
        <PlaybookFolderCard client:visible />
      </div>

      <OffClockCard client:visible />
    </div>
  </div>
</section>
