---
import AvailabilityBadge from '@/components/shared/availability-badge'
import GreetingWord from '@/components/home/hero/greeting-word'
import HeroCta from '@/components/home/hero/hero-cta'
import RoleTicker from '@/components/home/hero/role-ticker'
import IdCard from '@/components/ui/id-card'

import { PROFILE } from '@/consts'
---

<section class='lg:relative' data-no-reveal>
  <div class='border-b pb-8 max-sm:pt-20 sm:py-16 lg:pt-32 lg:pb-24'>
    <div class='px-4 sm:px-6 lg:px-10.5'>
      <div class='space-y-6 lg:max-w-lg'>
        <AvailabilityBadge className='h-6.5 gap-1 rounded-full' />
        <h1 class='mb-2 text-4xl font-semibold tracking-tight sm:text-5xl lg:text-[64px] lg:font-bold'>
          <GreetingWord client:load />I am {PROFILE.firstName} 👋🏻
        </h1>
        <p class='text-muted-foreground text-xl font-medium whitespace-nowrap sm:text-2xl lg:text-3xl'>
          <RoleTicker client:load />
        </p>
        <p class='mb-8 max-w-2xl text-base'>
          Technical delivery lead based in Islamabad. I've led teams from 10 to 60 people across SaaS, fintech and
          HealthTech - and with a software engineering background, I run delivery the way an engineer would want it run.
        </p>
        <HeroCta />
      </div>
    </div>
  </div>

  <!-- client:only — WebGL/Canvas can't SSR -->
  <IdCard
    client:only='react'
    frontImage='/images/hashim/portrait-card.webp'
    className='mx-auto mt-8 aspect-4/5 w-full max-w-80 max-lg:hidden lg:absolute lg:-top-31 lg:right-0 lg:left-0 lg:z-10 lg:mt-0 lg:aspect-auto lg:h-192 lg:max-w-none'
  />
</section>
