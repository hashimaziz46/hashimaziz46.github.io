---
import { ArrowRightIcon } from 'lucide-react'

import { Badge } from '@/components/ui/badge'
import { Button } from '@/components/ui/button'
import { Card } from '@/components/ui/card'

import { cn } from '@/lib/utils'
import type { CaseStudyMetadata } from '@/lib/case-studies'

interface Props {
  caseStudy: CaseStudyMetadata
  variant?: 'hero' | 'grid'
  imageSide?: 'left' | 'right'
}

const { caseStudy, variant = 'grid', imageSide = 'right' } = Astro.props
const year = caseStudy.publishedAt ? new Date(caseStudy.publishedAt).getFullYear() : undefined
const isHero = variant === 'hero'
---

<a href={`/case-study/${caseStudy.slug}`} class='block h-full no-underline' data-tilt={isHero ? '2' : '4'}>
  <Card
    className={cn(
      'group ring-border relative h-full transform-[perspective(1000px)_rotateX(var(--tilt-x,0deg))_rotateY(var(--tilt-y,0deg))] gap-0 overflow-hidden rounded-[24px] p-0 shadow-lg transition-all duration-300 ease-out hover:shadow-xl',
      isHero && (imageSide === 'left' ? 'md:flex-row-reverse' : 'md:flex-row')
    )}
  >
    <div class={cn('order-2 flex flex-col justify-between gap-3 p-4 sm:p-6', isHero ? 'sm:py-8 md:order-0' : '')}>
      <div class='space-y-3'>
        <h3
          class='line-clamp-2 text-xl font-medium md:text-2xl lg:text-[26px]'
          transition:name={`case-study-title-${caseStudy.slug}`}
        >
          {caseStudy.title}
        </h3>
        <div class='flex items-center gap-2.5'>
          {
            caseStudy.duration && (
              <Badge variant='outline' className='rounded-full border-(--background-darker) bg-(--background-darker)'>
                {caseStudy.duration}
              </Badge>
            )
          }
          {
            year && (
              <Badge variant='outline' className='rounded-full border-(--background-darker) bg-(--background-darker)'>
                {year}
              </Badge>
            )
          }
        </div>
        <p class='text-muted-foreground line-clamp-3 text-base'>{caseStudy.description}</p>
      </div>

      <div class='flex items-center justify-between gap-2 border-t pt-3'>
        {
          caseStudy.organisation && (
            <div class='flex items-center gap-3'>
              {caseStudy.logo && (
                <div class='flex shrink-0 items-center justify-center overflow-hidden rounded-md border'>
                  <img src={caseStudy.logo} alt={`${caseStudy.organisation} logo`} class='size-10.5' />
                </div>
              )}
              <div class='text-base'>
                <p class='text-foreground font-medium'>{caseStudy.organisation}</p>
                {caseStudy.role && <p class='text-muted-foreground'>{caseStudy.role}</p>}
              </div>
            </div>
          )
        }
        <div
          class='bg-card dark:border-accent-foreground/10 flex size-11 items-center justify-center rounded-full border shadow-md'
        >
          <Button
            size='icon'
            variant='outline'
            className='hover:bg-accent dark:hover:bg-accent bg-accent dark:bg-accent text-background hover:text-background dark:text-accent-foreground border-accent size-7 shrink-0 overflow-hidden rounded-full'
          >
            <span class='relative block size-4'>
              <ArrowRightIcon
                className='absolute inset-0 size-4 -rotate-45 transition-transform duration-400 ease-in-out group-hover:translate-x-5 group-hover:-translate-y-5'
              />
              <ArrowRightIcon
                className='absolute inset-0 size-4 -translate-x-5 translate-y-5 -rotate-45 transition-transform duration-400 ease-in-out group-hover:translate-x-0 group-hover:translate-y-0'
              />
            </span>
            <span class='sr-only'>Read case study: {caseStudy.title}</span>
          </Button>
        </div>
      </div>
    </div>

    {
      caseStudy.image && (
        <div class={cn('relative order-1 w-full overflow-hidden', isHero ? 'md:order-0 md:max-w-1/2' : '')}>
          <img
            src={caseStudy.image}
            alt={caseStudy.title ?? ''}
            class={cn(
              'w-full object-cover transition-all duration-300 group-hover:scale-105',
              isHero ? 'h-full max-h-81' : 'h-68'
            )}
          />
        </div>
      )
    }

    <!-- Soft highlight that follows the pointer while the card tilts -->
    <div
      class='tilt-glare pointer-events-none absolute inset-0 opacity-0 transition-opacity duration-300 group-hover:opacity-100'
      aria-hidden='true'
    >
    </div>
  </Card>
</a>

<script>
  // Tilt cards toward the pointer. The value of data-tilt is the maximum angle in degrees.
  const initTilt = () => {
    if (!window.matchMedia('(hover: hover) and (pointer: fine)').matches) return
    if (window.matchMedia('(prefers-reduced-motion: reduce)').matches) return

    document.querySelectorAll<HTMLElement>('[data-tilt]').forEach(card => {
      if (card.dataset.tiltReady) return

      card.dataset.tiltReady = 'true'

      const maxTilt = Number(card.dataset.tilt) || 4

      card.addEventListener('pointermove', event => {
        const rect = card.getBoundingClientRect()
        const x = (event.clientX - rect.left) / rect.width
        const y = (event.clientY - rect.top) / rect.height

        card.style.setProperty('--tilt-x', `${((0.5 - y) * 2 * maxTilt).toFixed(2)}deg`)
        card.style.setProperty('--tilt-y', `${((x - 0.5) * 2 * maxTilt).toFixed(2)}deg`)
        card.style.setProperty('--glare-x', `${(x * 100).toFixed(1)}%`)
        card.style.setProperty('--glare-y', `${(y * 100).toFixed(1)}%`)
      })

      card.addEventListener('pointerleave', () => {
        card.style.removeProperty('--tilt-x')
        card.style.removeProperty('--tilt-y')
      })
    })
  }

  document.addEventListener('astro:page-load', initTilt)
</script>
